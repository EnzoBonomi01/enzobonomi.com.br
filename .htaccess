DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Serve the built Vite app from the repo root on Apache/LiteSpeed hosts.
  RewriteRule ^$ dist/index.html [L]
  RewriteRule ^dist-assets/(.*)$ dist/dist-assets/$1 [L]

  # Keep existing source/dev files addressable when needed.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Fallback to the built entry for non-file requests.
  RewriteRule ^ dist/index.html [L]
</IfModule>
